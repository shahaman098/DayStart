<?xml version="1.0" encoding="utf-8"?>
<!--
  DayStart adaptive foreground — sunrise cresting a horizon, matching the existing Play
  Store icon (play-store/assets/play_icon_512.png) composition/geometry directly rather
  than approximating it, so the in-app launcher icon finally agrees with the store listing
  instead of showing an unrelated plain clock. Artwork stays inside the ~66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rays, fanned across the top only -->
    <path
        android:strokeColor="#FFA23C"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M32.25,47.86 L24.09,44.05 M37.63,40.45 L31.49,33.86 M45.4,35.59 L42.17,27.19 M54,34 L54,25 M62.6,35.59 L65.83,27.19 M70.37,40.45 L76.51,33.86 M75.75,47.86 L83.91,44.05" />

    <!-- Sun — half-disc cresting the horizon at y=58 -->
    <path android:pathData="M32,58 A22,22 0 0 1 76,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="36"
                android:endX="54"
                android:endY="58"
                android:startColor="#FF9A3C"
                android:endColor="#FFC93C" />
        </aapt:attr>
    </path>
</vector>
